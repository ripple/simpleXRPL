{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "tsconfig": "tsconfig.esm.json",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "externalPattern": ["**/node_modules/**", "**/src/generated/**"],
  "readme": "README.md",
  "name": "simpleXRPL"
}
