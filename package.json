{
  "name": "simplexrpl",
  "version": "0.0.0",
  "description": "A high-level TypeScript SDK for the XRP Ledger, scoped to the institutional / Web2 audience.",
  "license": "ISC",
  "author": "Ripple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ripple/simpleXRPL.git"
  },
  "keywords": [
    "xrp",
    "xrpl",
    "xrp ledger",
    "ripple",
    "custody",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "clean": "rimraf dist coverage tsconfig.*.tsbuildinfo",
    "typegen": "run-s typegen:custody typegen:palisade",
    "typegen:custody": "openapi-typescript openapi/custody-v1.35-openapi.json -o src/generated/custody.ts && prettier --write src/generated/custody.ts",
    "typegen:palisade": "openapi-typescript openapi/palisade-api.yaml -o src/generated/palisade.ts && prettier --write src/generated/palisade.ts",
    "prebuild": "npm run clean",
    "build": "run-s build:cjs build:esm fixup",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "fixup": "node scripts/fixup-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.unit.cjs",
    "test:watch": "jest --config jest.config.unit.cjs --watch",
    "test:integration": "jest --config jest.config.integration.cjs --runInBand",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,mjs}\"",
    "docgen": "typedoc",
    "prepublishOnly": "run-s clean build"
  },
  "prettier": "@xrplf/prettier-config",
  "dependencies": {
    "bignumber.js": "^9.3.1",
    "canonicalize": "^2.0.0",
    "xrpl": "^4.1.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@xrplf/eslint-config": "^3.0.0",
    "@xrplf/prettier-config": "^1.9.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-array-func": "^5.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^52.0.4",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "npm-run-all2": "^7.0.2",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
